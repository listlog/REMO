# Server only. Set through the Neon integration in the Vercel project.
# For local checks, place the value in .env.local (never commit it).
DATABASE_URL=

# Server-only administrator password (12-256 characters). Set in Vercel, never commit.
REMO_ADMIN_PASSWORD=

# Gemini server-only key. Store as a Production Secret in Vercel.
GEMINI_API_KEY=
# Non-secret model config. Free tier eligibility depends on the Google project.
GEMINI_MODEL=gemini-3.5-flash-lite
